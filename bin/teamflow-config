#!/usr/bin/env python3
"""Print this repository's effective teamflow configuration.

    teamflow-config            # the whole config, as JSON
    teamflow-config <key>      # one value, e.g. loop.max_iterations

Reads .claude/teamflow.json at the repository root and fills in defaults for
anything it does not set. Configuration is per repository, so it is committed
with the project rather than kept in each user's settings.
"""

import json
import subprocess
import sys

DEFAULTS = {
    "loop": {
        "max_iterations": 3,
        "exit_severity_threshold": "medium",
        "human_checkpoint": "every_cycle",
        "max_open_issues_to_continue": 0,
    },
}

ALLOWED = {
    "loop.exit_severity_threshold": {"high", "medium", "low", "none"},
    "loop.human_checkpoint": {"every_cycle", "first_loop_only", "never"},
}


def merge(base, override, path=""):
    out = dict(base)
    for key, value in override.items():
        where = f"{path}{key}"
        if key not in base:
            sys.exit(f"teamflow-config: unknown key '{where}'")
        if isinstance(base[key], dict):
            if not isinstance(value, dict):
                sys.exit(f"teamflow-config: '{where}' must be an object")
            out[key] = merge(base[key], value, where + ".")
        else:
            if type(value) is not type(base[key]):
                kind = {"int": "an integer", "str": "a string"}[type(base[key]).__name__]
                sys.exit(f"teamflow-config: '{where}' must be {kind}")
            if where in ALLOWED and value not in ALLOWED[where]:
                sys.exit(f"teamflow-config: '{where}' must be one of {sorted(ALLOWED[where])}")
            out[key] = value
    return out


def main():
    try:
        root = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        sys.exit("teamflow-config: not inside a git repository")

    try:
        with open(f"{root}/.claude/teamflow.json", encoding="utf-8") as f:
            raw = json.load(f)
    except FileNotFoundError:
        raw = {}
    except ValueError as error:
        sys.exit(f"teamflow-config: .claude/teamflow.json is not valid JSON ({error})")
    if not isinstance(raw, dict):
        sys.exit("teamflow-config: .claude/teamflow.json must be a JSON object")

    config = merge(DEFAULTS, raw)

    if len(sys.argv) == 1:
        print(json.dumps(config, indent=2))
        return
    value = config
    for part in sys.argv[1].split("."):
        if not isinstance(value, dict) or part not in value:
            sys.exit(f"teamflow-config: unknown key '{sys.argv[1]}'")
        value = value[part]
    print(json.dumps(value) if isinstance(value, dict) else value)


if __name__ == "__main__":
    main()
