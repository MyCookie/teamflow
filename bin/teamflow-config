#!/usr/bin/env python3
"""Print this repository's effective teamflow configuration.

    teamflow-config            # the whole config, as JSON
    teamflow-config <key>      # one value, e.g. loop.max_iterations

Reads .claude/teamflow.json from the main worktree, the trusted checkout the
team runs from, and fills in defaults for anything it does not set. Never the
current worktree: a reviewer's worktree holds the PR under review, which must
not choose the rules its own review and merge run under. For the same reason
the main worktree must be on the base branch: on any other branch its copy of
the file is unreviewed, so that is a setup problem (exit 2). Configuration is
per repository, so it is committed with the project rather than kept in each
user's settings.
"""

import json
import subprocess
import sys


def fail(message):
    """Configuration problems are setup problems: exit 2, like tf."""
    print(f"teamflow-config: {message}", file=sys.stderr)
    sys.exit(2)

DEFAULTS = {
    "forge": "local",
    "remote": "origin",
    "base": "main",
    "loop": {
        "max_iterations": 3,
        "exit_severity_threshold": "medium",
        "human_checkpoint": "every_cycle",
        "max_open_issues_to_continue": 0,
    },
}

ALLOWED = {
    "forge": {"local", "github"},
    "loop.exit_severity_threshold": {"high", "medium", "low", "none"},
    "loop.human_checkpoint": {"every_cycle", "first_loop_only", "never"},
}


def merge(base, override, path=""):
    out = dict(base)
    for key, value in override.items():
        where = f"{path}{key}"
        if key not in base:
            fail(f"unknown key '{where}'")
        if isinstance(base[key], dict):
            if not isinstance(value, dict):
                fail(f"'{where}' must be an object")
            out[key] = merge(base[key], value, where + ".")
        else:
            if type(value) is not type(base[key]):
                kind = {"int": "an integer", "str": "a string"}[type(base[key]).__name__]
                fail(f"'{where}' must be {kind}")
            if where in ALLOWED and value not in ALLOWED[where]:
                fail(f"'{where}' must be one of {sorted(ALLOWED[where])}")
            out[key] = value
    return out


def main():
    try:
        listing = subprocess.run(
            ["git", "worktree", "list", "--porcelain"],
            capture_output=True, text=True, check=True,
        ).stdout.split("\n\n")[0].splitlines()
    except (OSError, subprocess.CalledProcessError):
        fail("not inside a git repository")
    root = listing[0].removeprefix("worktree ")
    branch = next((l.removeprefix("branch refs/heads/") for l in listing if l.startswith("branch ")), None)

    try:
        with open(f"{root}/.claude/teamflow.json", encoding="utf-8") as f:
            raw = json.load(f)
    except FileNotFoundError:
        raw = {}
    except ValueError as error:
        fail(f".claude/teamflow.json is not valid JSON ({error})")
    if not isinstance(raw, dict):
        fail(".claude/teamflow.json must be a JSON object")

    config = merge(DEFAULTS, raw)
    if "bare" in listing:
        fail(f"the main checkout ({root}) is a bare repository; teamflow needs a main "
             f"worktree on {config['base']} to read its config from")
    # ponytail: `base` comes from the file this check protects, so a main worktree
    # on branch X whose own config says base X passes. Only a human breaking the
    # rule gets there, and tf pr merge still refuses a PR that targets the real base.
    if branch != config["base"]:
        fail(f"the main worktree ({root}) must be on {config['base']}, not "
             f"{branch or 'a detached HEAD'}: its config is trusted only there. "
             "Work on other branches in separate worktrees.")

    if len(sys.argv) == 1:
        print(json.dumps(config, indent=2))
        return
    value = config
    for part in sys.argv[1].split("."):
        if not isinstance(value, dict) or part not in value:
            fail(f"unknown key '{sys.argv[1]}'")
        value = value[part]
    print(json.dumps(value) if isinstance(value, dict) else value)


if __name__ == "__main__":
    main()
